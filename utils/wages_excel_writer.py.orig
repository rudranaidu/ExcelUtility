from openpyxl import Workbook
from openpyxl.styles import Font, Alignment, Border, Side
from openpyxl.utils import get_column_letter


def write_wages_report(df, output_buffer, month_label):
    wb = Workbook()
    ws = wb.active

    bold = Font(bold=True)
    center = Alignment(horizontal="center", vertical="center", wrap_text=True)

    border = Border(
        left=Side(style="thin"),
        right=Side(style="thin"),
        top=Side(style="thin"),
        bottom=Side(style="thin"),
    )

    # ============================
    # 🔰 TITLE & HEADER BLOCK
    # ============================

    ws.merge_cells("A1:W1")
    ws["A1"] = "FORM-XVII REGISTER OF WAGES"
    ws["A1"].font = Font(bold=True, size=14)
    ws["A1"].alignment = center

    ws.merge_cells("A2:W2")
    ws["A2"] = "VIDE RULE 78 (1) A (i) OF CONTRACT LABOUR (REG. & ABOLITION) CENTRAL & A.P. RULES"
    ws["A2"].font = bold
    ws["A2"].alignment = center

    ws["A4"] = "Name and Address of Contractor ::  PAVANII ENTERPRISES"
    ws["A5"] = "Nature and Location of Work ::  EPURU-1A, MUTHUKURU, SPSR NELLORE, PH:9550999951."
    ws["A6"] = f"Wage-period : Monthly  ::  {month_label}"

    ws["N4"] = "Name and Address of Establishment in / under  ::  GEMINI EDIBLES AND FATS LTD."
    ws["N5"] = "which contract is carried on  ________________________________"
    ws["N6"] = "Name and Address of Principal Employer  ::  EPURU-1A, MUTHUKURU, SPSR NELLORE."

    for r in range(4, 7):
        for c in ["A", "N"]:
            ws[f"{c}{r}"].font = bold

    # ============================
    # 🧱 TABLE HEADER
    # ============================

    header_row = 9

    headers = [
        "Sl. No.", "Name of the workman", "Emp", "UAN NUMBER", "ESI NUMBER",
        "Bank Acc. No", "Bank Name", "Designation / Nature of work done",
        "No. of days worked", "Rate per day", "Basic Wages", "Leave with wages (LWW)",
        "Bonus @8.33%", "National Festival Holidays (NFH)", "Washing Allowances",
        "Gross", "ESI", "PF", "ESI", "Transportation", "PT", "TAKE HOME", "Signature"
    ]

    for c, h in enumerate(headers, start=1):
        cell = ws.cell(row=header_row, column=c, value=h)
        cell.font = bold
        cell.alignment = center
        cell.border = border

    # ============================
    # 📊 DATA (EXACT COLUMN MAPPING)
    # ============================

    row_start = header_row + 1

    for i, row in enumerate(df.itertuples(index=False), start=1):
        excel_row = row_start + i - 1

        ordered = [
            i,
            row.Name,
            row.EmpID,
            row.UAN,
            row.ESI,
            row.BankAccount,
            row.BankName,
            row.Category,
            row.WorkingDays,
            row.RatePerDay,
            row.BasicWages,
            row.LWW,
            row.Bonus,
            row.NFH,
            row.WashingAllowance,
            row.Gross,
            row.ESI_Deduction,
            row.PF,
            row.ESI_Deduction,
            row.Transport,
            row.PT,
            row.TakeHome,
            ""
        ]

        for c, value in enumerate(ordered, start=1):
            cell = ws.cell(row=excel_row, column=c, value=value)
            cell.font = bold
            cell.alignment = center
            cell.border = border

    # ============================
    # 📐 COLUMN WIDTHS
    # ============================

    widths = [6, 22, 10, 14, 14, 14, 14, 16, 10, 10, 12, 14, 12, 16, 14, 12, 8, 8, 8, 12, 8, 12, 14]

    for i, w in enumerate(widths, start=1):
        ws.column_dimensions[get_column_letter(i)].width = w

    wb.save(output_buffer)

